{
  "name": "lucid",
  "version": "0.1.0",
  "description": "A living office for your T3 Code agents.",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/setup-git-sync.cjs --if-enabled",
    "dev": "node scripts/dev.mjs",
    "dev:playgrounds": "vite --config dev/vite.config.mjs",
    "build": "vite build",
    "start": "node scripts/launch.cjs",
    "typecheck": "node electron/runtime-check.cjs && tsc -p .",
    "verify:soundtrack": "node scripts/run-checks.mjs soundtrack",
    "verify:update": "npm run typecheck && node scripts/run-checks.mjs && npm run build",
    "test": "node scripts/run-checks.mjs",
    "icons": "node scripts/build-icons.mjs",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs --publish never"
  },
  "type": "commonjs",
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "dompurify": "^3.4.17",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "gsap": "^3.15.0",
    "marked": "^18.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
